{
  "name": "tabtidy-chrome-extension",
  "version": "1.0.0",
  "description": "Manifest V3 Chrome extension for local similarity-based tab grouping, unnecessary-tab triage, deduplication, search, and session stashing.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tesso57/tabtidy.git"
  },
  "homepage": "https://github.com/tesso57/tabtidy#readme",
  "bugs": {
    "url": "https://github.com/tesso57/tabtidy/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mts",
    "knip": "knip",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.3.0",
    "knip": "^6.45.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
